---
/** A multi-line field, as Input: label, hint, error. */
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"textarea">, "class"> & {
  label: string;
  hint?: string;
  error?: string;
  hideLabel?: boolean;
  class?: string;
};

const {
  label,
  hint,
  error,
  hideLabel = false,
  rows = 4,
  id = `textarea-${Math.random().toString(36).slice(2, 8)}`,
  class: className,
  ...rest
} = Astro.props;
const note = error ?? hint;
---

<div class:list={["flex flex-col gap-1.5", className]}>
  <label for={id} class:list={["text-small font-medium text-ink-1", hideLabel && "sr-only"]}>
    {label}
  </label>
  <textarea
    id={id}
    rows={rows}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={note ? `${id}-note` : undefined}
    class:list={[
      "w-full min-w-0 resize-y rounded-sm border border-line-2 bg-surface-1 px-3 py-2.5 text-regular text-ink-1 transition-colors",
      "placeholder:text-ink-4 hover:bg-surface-2 focus-visible:border-line-brand focus-visible:outline-none",
      "aria-invalid:border-danger",
      "disabled:cursor-not-allowed disabled:bg-surface-2 disabled:text-ink-4",
    ]}
    {...rest}></textarea>
  {
    note && (
      <p id={`${id}-note`} class:list={["text-small", error ? "text-danger" : "text-ink-3"]}>
        {note}
      </p>
    )
  }
</div>
