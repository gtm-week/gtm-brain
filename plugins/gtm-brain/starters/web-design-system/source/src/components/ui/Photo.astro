---
/**
 * A photo at a fixed ratio, cropped to fill it. Pass an imported image to get a srcset
 * (astro:assets); `alt` says what it shows, or "" when it only decorates.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  /** What the photo shows; "" when it only decorates. */
  alt: string;
  ratio?: "16/9" | "3/2" | "4/3" | "1/1" | "3/4";
  /** How wide it is drawn, for the browser to pick a size: "(min-width: 64rem) 50vw, 100vw". */
  sizes?: string;
  /** The photo of the first screen: loaded at once, not lazily. */
  priority?: boolean;
  /** The crop, as object-position ("50% 20%"); centred by default. */
  position?: string;
  class?: string;
}
const { src, alt, ratio = "4/3", sizes = "100vw", priority = false, position, class: className } = Astro.props;

const ratios = {
  "16/9": "aspect-16/9",
  "3/2": "aspect-3/2",
  "4/3": "aspect-4/3",
  "1/1": "aspect-square",
  "3/4": "aspect-3/4",
} as const;
const image = {
  alt,
  loading: priority ? ("eager" as const) : ("lazy" as const),
  class: "size-full object-cover",
  style: position ? `object-position: ${position}` : undefined,
};
---

<div class:list={["overflow-hidden rounded-sm bg-surface-2", ratios[ratio], className]}>
  {
    typeof src === "string" ? (
      <img src={src} {...image} />
    ) : (
      <Image src={src} widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)} sizes={sizes} {...image} />
    )
  }
</div>
