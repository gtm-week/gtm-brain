---
/**
 * A customer's logo on a tile, quiet at rest, full on hover. Without an image it
 * shows the name, so a logo wall can be built before the files arrive.
 */
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

type Props = Omit<HTMLAttributes<"div">, "class"> & {
  name: string;
  logo?: ImageMetadata | string;
  href?: string;
  class?: string;
};
const { name, logo, href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "group flex h-24 items-center justify-center rounded-sm border border-line bg-surface-1 px-6 transition-colors focus-visible:border-line-brand focus-visible:outline-none",
    className,
  ]}
  {...rest}
>
  {
    !logo ? (
      <span class="text-large font-medium text-ink-4 transition-colors group-hover:text-ink-1">
        {name}
      </span>
    ) : typeof logo === "string" ? (
      <img
        src={logo}
        alt={name}
        class="max-h-8 w-auto opacity-50 grayscale transition group-hover:opacity-100 group-hover:grayscale-0"
      />
    ) : (
      <Image
        src={logo}
        alt={name}
        class="max-h-8 w-auto opacity-50 grayscale transition group-hover:opacity-100 group-hover:grayscale-0"
      />
    )
  }
</Tag>
