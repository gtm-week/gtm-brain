---
/** A customer's words, their name and role, and a photo or initials. */
import type { ImageMetadata } from "astro";
import Avatar from "./Avatar.astro";

interface Props {
  quote: string;
  name: string;
  role?: string;
  photo?: ImageMetadata | string;
  /** Larger quote, for the one that leads. */
  featured?: boolean;
  class?: string;
}
const { quote, name, role, photo, featured = false, class: className } = Astro.props;
---

<figure
  class:list={[
    "flex h-full flex-col justify-between gap-8 rounded-sm border border-line bg-surface-1 p-6",
    className,
  ]}
>
  <blockquote class:list={[featured ? "heading-h4" : "text-large", "text-ink-1"]}>
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="flex items-center gap-3">
    <Avatar name={name} src={photo} />
    <span class="flex flex-col">
      <span class="text-small font-medium text-ink-1">{name}</span>
      {role && <span class="text-small text-ink-3">{role}</span>}
    </span>
  </figcaption>
</figure>
