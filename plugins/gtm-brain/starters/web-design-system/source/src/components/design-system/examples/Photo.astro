---
import DsBlock from "../DsBlock.astro";
import DsStage from "../DsStage.astro";
import DsState from "../DsState.astro";
import DsProps from "../DsProps.astro";
import Photo from "../../ui/Photo.astro";
import photo from "../../../assets/placeholders/photo.jpg";

interface Props {
  /** A small preview for the overview grid. */
  thumb?: boolean;
}
const { thumb = false } = Astro.props;
const ratios = ["16/9", "4/3", "1/1", "3/4"] as const;
---

{
  thumb ? (
    <Photo src={photo} alt="" ratio="4/3" sizes="200px" class="w-44" />
  ) : (
    <>
      <DsBlock title="Ratios" description="16/9 · 3/2 · 4/3 (the default) · 1/1 · 3/4. The photo is cropped to fill the box; position moves the crop.">
        <DsStage layout="states" cols={4} class="items-start">
          {ratios.map((ratio) => (
            <DsState label={ratio} class="items-stretch">
              <Photo src={photo} alt="A placeholder photo" ratio={ratio} sizes="(min-width: 64rem) 25vw, 100vw" class="w-full" />
            </DsState>
          ))}
        </DsStage>
      </DsBlock>
      <DsBlock title="In a layout" description="Wide beside text, the way a two-panel section uses it. Pass sizes so the browser loads the right width.">
        <DsStage layout="stack">
          <div class="grid items-center gap-8 md:grid-cols-2">
            <Photo src={photo} alt="A placeholder photo" ratio="3/2" sizes="(min-width: 48rem) 50vw, 100vw" />
            <p class="max-w-measure-sm text-regular text-ink-2">A section's images live in src/assets/sections/&lt;name&gt;/ and come in as imports, so they are resized at build.</p>
          </div>
        </DsStage>
      </DsBlock>
      <DsBlock title="Props"><DsProps of="components/ui/Photo" /></DsBlock>
    </>
  )
}
