<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The newest installed GTM Brain runs: no version in the path, so an update never breaks the schedule. The highest version number wins, not the last one written. Replace YOU and your-brain. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.gtm-brain.compile</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>p="$(ls -d "${CODEX_HOME:-$HOME/.codex}"/plugins/cache/gtm-brain/gtm-brain/[0-9]*/ 2&gt;/dev/null | sort -V | tail -1)"; [ -n "$p" ] || { echo "gtm-brain: plugin not installed" &gt;&amp;2; exit 1; }; exec /bin/bash "${p}scripts/gtm-brain-schedule/scheduled-run.sh" "$0"</string>
    <string>/Users/YOU/your-brain</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/gtm-brain-compile.log</string>
  <key>StandardErrorPath</key><string>/tmp/gtm-brain-compile.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
